# Variables del cliente (issue #60, DEC-069). Copia este archivo a `.env.local` (ignorado por git).
# Todo lo que empieza por VITE_ termina en el bundle y es PÚBLICO: aquí solo van la URL del
# proyecto, la clave publicable y la site key de Turnstile. Nunca la service_role ni una
# clave sb_secret_ (regla dura 3); el build falla si aparecen (scripts/check-bundle-secrets.mjs).

# Cuentas apagadas por defecto: sin esta variable en "true" la app funciona sin cuentas.
VITE_ENABLE_ACCOUNTS=false

# Local: salida de `pnpm db:start` (API_URL y PUBLISHABLE_KEY).
# Nube: panel de Supabase > Project Settings > API Keys > Publishable key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplazar

# Cloudflare Turnstile, site key pública. Vacía en local (el captcha solo está activo en la nube).
VITE_TURNSTILE_SITE_KEY=
